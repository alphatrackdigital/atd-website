# Admin console. Required: the origin of the backend that serves the admin API
# (repo: alphatrackdigital/atd-backend-test). The console has no same-origin
# fallback and will not start without this.
#
# MONGODB_URI and JWT_SECRET are NOT set here. They are backend runtime config
# and belong on that backend's deployment, not in this frontend build - Vite
# only exposes VITE_-prefixed variables to the client bundle.
VITE_ADMIN_API_BASE_URL=https://atd-backend-test.vercel.app
