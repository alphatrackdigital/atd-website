{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "atd-website-qa",
  "main": "./qa-worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
